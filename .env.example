# Render Deployment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Server Configuration
PORT=3000

# Data Persistence
# SQLite database path for user accounts, clans, and progression
DATABASE_FILE=./forestbrawl.db

# Authentication
# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Owner panel (never commit real values)
# Use a long random password stored only in your deployment secret manager.
OWNER_USERNAME=
OWNER_PASSWORD=

# Comma-separated browser origins allowed to use Socket.IO
ALLOWED_ORIGINS=https://forestbrawl.fun,http://localhost:3000,http://127.0.0.1:3000

# Environment
NODE_ENV=production
